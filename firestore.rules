rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function dueno() {
      return request.auth != null && request.auth.token.email == "niltonaquino0201@gmail.com";
    }
    function trabajador() {
      return request.auth != null
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.token.email))
        && get(/databases/$(database)/documents/usuarios/$(request.auth.token.email)).data.activo == true;
    }
    match /{document=**} {
      allow read, write: if dueno();
    }
    match /productos/{id} { allow read, write: if trabajador(); }
    match /ventas/{id} { allow read, write: if trabajador(); }
    match /compras/{id} { allow read, write: if trabajador(); }
    match /cotizaciones/{id} { allow read, write: if trabajador(); }
    match /escaneos/{id} { allow read, write: if trabajador(); }
    match /config/{id} {
      allow read: if trabajador();
      allow write: if trabajador() && id == "correlativos";
    }
    match /usuarios/{email} {
      allow read: if request.auth != null && request.auth.token.email == email;
    }
  }
}
